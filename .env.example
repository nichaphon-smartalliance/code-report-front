# Base URL the browser uses for the API.
# SPEC-001 / Q-SA-5: frontend and backend are served on the SAME ORIGIN with
# `/api/*` proxied to the backend, so the default is a path and there is no CORS.
NEXT_PUBLIC_API_BASE_URL=/api

# Local development only. Next rewrites `/api/*` to this origin so the browser
# still sees one origin and the session cookie behaves exactly as in production.
# Leave unset in production — the reverse proxy does the routing.
# 8080 is `PORT` in code-report-back/.env.example (TASK-001).
API_PROXY_TARGET=http://localhost:8080
